# Required
JWT_SECRET=replace-with-a-long-random-string

# AI provider — Gemini is tried first if set (free standing tier), Anthropic
# is the fallback if Gemini is unset or its call fails. Set one or both.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional — server runs fine without these, matching features just stay disabled
PORT=4111
DB_PATH=./data/eduai.db

# Email (password resets, notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Push notifications (Firebase Cloud Messaging)
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Multilingual UI
GOOGLE_TRANSLATE_API_KEY=

# Live job feed (Placement portal)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Text-to-speech
GOOGLE_TTS_API_KEY=

# Vector DB upgrade (RAG) — falls back to local in-memory vectors if unset
PINECONE_API_KEY=
PINECONE_HOST=
VOYAGE_API_KEY=
OPENAI_API_KEY=

# Certificate blockchain anchor (Sepolia testnet recommended, never mainnet keys)
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_ANCHOR_ADDRESS=
BLOCKCHAIN_EXPLORER_BASE=https://sepolia.etherscan.io/tx/

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
WRITE_RATE_LIMIT_PER_MINUTE=30

# OAuth Sign-In ("Continue with Google/LinkedIn/GitHub") — each provider's
# button is only enabled once its two vars below are set. Redirect URI to
# register with each provider is:
#   <PUBLIC_BASE_URL or your deployed URL>/api/auth/oauth/<provider>/callback
# e.g. https://your-app.onrender.com/api/auth/oauth/google/callback
PUBLIC_BASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
